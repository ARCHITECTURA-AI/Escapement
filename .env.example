# Copy to .env. Everything here is optional in local mode.
ESCAPEMENT_MODE=local                      # "public" rejects every admin call
ESCAPEMENT_WEB_BASE_URL=http://localhost:3000
ESCAPEMENT_SEED_SECRET=change-me           # salts Daily and season seeds; keep secret when hosted
ESCAPEMENT_SIGNING_KEY=                    # base64 Ed25519 seed; generated into the data dir locally
ESCAPEMENT_GITHUB_CLIENT_ID=
ESCAPEMENT_GITHUB_CLIENT_SECRET=
ESCAPEMENT_COOKIE_SECURE=false
# Reference worker
ESCAPEMENT_REFERENCE_KEY=                  # escapement-api ops reference-key
GROQ_API_KEY=
REFERENCE_MODELS=openai/gpt-oss-20b
